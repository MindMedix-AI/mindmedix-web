# MindMedix AI - Institutional Infrastructure
# Environment Configuration Example

# THE BASICS
# The absolute production URL (e.g., https://mindmedixai.health)
# Required for Sitemap and canonical SEO tags.
NEXT_PUBLIC_BASE_URL=https://mindmedixai.health

# EMAIL INFRASTRUCTURE (Optional)
# If you integrate Resend or SendGrid for the contact form:
# RESEND_API_KEY=re_123456789
# CONTACT_EMAIL=founder@mindmedixai.health

# ANALYTICS (Optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# DECAP CMS GITHUB OAUTH (Required for the CMS admin at /admin)
# Create a GitHub OAuth App: Settings → Developer settings → OAuth Apps
#   Homepage URL:  https://mindmedixai.health
#   Callback URL:  https://mindmedixai.health/api/decap/callback
# Then add these two secrets to your Vercel project environment.
# GITHUB_OAUTH_CLIENT_ID=Ov23liXXXXXXXXXX
# GITHUB_OAUTH_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
